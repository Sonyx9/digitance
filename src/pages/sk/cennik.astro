---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getPathForLocale, type Locale } from '../../lib/i18n';
import { pricingRows } from '../../data/pricing';
import PricingPageContent from '../../components/PricingPageContent.astro';

const locale = Astro.currentLocale as Locale;

const t = {
  heroLabel: 'Kolko to stoji',
  heroTitle: 'Cennik',
  heroSubLeft: 'Prehladne ceny nasich sluzieb na jednom mieste.',
  note: 'Ceny na tejto stranke su prevzate z jednotlivych podstranok sluzieb. Tam, kde podstranka cenu neuvadza, je uvedene na vyziadanie.',
  ctaLabel: 'Dohodnut nezavaznu konzultaciu',
};
---

<BaseLayout title={`${t.heroTitle} — digitance.`} description={t.heroSubLeft}>
  <PricingPageContent
    locale={locale}
    heroLabel={t.heroLabel}
    heroTitle={t.heroTitle}
    heroSubLeft={t.heroSubLeft}
    note={t.note}
    ctaLabel={t.ctaLabel}
    ctaHref={getRelativeLocaleUrl(locale, getPathForLocale(locale, 'contact'))}
    rows={pricingRows}
  />
</BaseLayout>
