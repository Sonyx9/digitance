---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale } from '../../lib/i18n';
import Reveal from '../../components/Reveal.astro';
import PageHero from '../../components/PageHero.astro';

const locale = Astro.currentLocale as Locale;

const t = {
  cs: {
    tag: 'Kontakt',
    title: 'Kontakt',
    heroLabel: 'Napište nám',
    heroSubLeft: 'jsme tu pro váš projekt v Česku i na Slovensku',
    sub: 'Rádi s vámi probereme váš projekt a navrhneme nejlepší postup.',
    cta: 'Napište nám',
    czRegion: 'Česko',
    czPhone: '+420 605 907 866',
    czEmail: 'lukas.koula@digitance.eu',
    czPlace: 'Praha, Liberec',
    skRegion: 'Slovensko',
    skPhone: '+421 948 148 238',
    skEmail: 'stanislav.hazucha@digitance.eu',
    skPlace: 'Liptovský Mikuláš',
    faqTitle: 'FAQ',
    faqItems: [
      {
        q: 'Jak rychle se mi ozvete?',
        a: 'Na e-mail odpovídáme zpravidla do 24 hodin v pracovních dnech.',
      },
      {
        q: 'Je první konzultace nezávazná?',
        a: 'Ano, úvodní konzultace je nezávazná a pomůže nám pochopit vaše cíle.',
      },
      {
        q: 'Pomůžete i s realizací po auditu?',
        a: 'Ano, po auditu můžeme doporučení také rovnou implementovat.',
      },
    ],
  },
  sk: {
    tag: 'Kontakt',
    title: 'Kontakt',
    heroLabel: 'Napíšte nám',
    heroSubLeft: 'sme tu pre váš projekt v Česku aj na Slovensku',
    sub: 'Radi s vami prejdeme váš projekt a navrhneme najlepší postup.',
    cta: 'Napíšte nám',
    czRegion: 'Česko',
    czPhone: '+420 605 907 866',
    czEmail: 'lukas.koula@digitance.eu',
    czPlace: 'Praha, Liberec',
    skRegion: 'Slovensko',
    skPhone: '+421 948 148 238',
    skEmail: 'stanislav.hazucha@digitance.eu',
    skPlace: 'Liptovský Mikuláš',
    faqTitle: 'FAQ',
    faqItems: [
      {
        q: 'Ako rýchlo sa mi ozvete?',
        a: 'Na e-mail odpovedáme spravidla do 24 hodín počas pracovných dní.',
      },
      {
        q: 'Je prvá konzultácia nezáväzná?',
        a: 'Áno, úvodná konzultácia je nezáväzná a pomôže nám pochopiť vaše ciele.',
      },
      {
        q: 'Pomôžete aj s realizáciou po audite?',
        a: 'Áno, po audite vieme odporúčania aj priamo implementovať.',
      },
    ],
  },
  en: {
    tag: 'Contact',
    title: 'Contact',
    heroLabel: 'Get in touch',
    heroSubLeft: 'we are here for your project in Czechia and Slovakia',
    sub: 'Let us discuss your project and propose the best next steps.',
    cta: 'Send us a message',
    czRegion: 'Czech Republic',
    czPhone: '+420 605 907 866',
    czEmail: 'lukas.koula@digitance.eu',
    czPlace: 'Prague, Liberec',
    skRegion: 'Slovakia',
    skPhone: '+421 948 148 238',
    skEmail: 'stanislav.hazucha@digitance.eu',
    skPlace: 'Liptovský Mikuláš',
    faqTitle: 'FAQ',
    faqItems: [
      {
        q: 'How quickly will you get back to me?',
        a: 'We usually reply within 24 hours on business days.',
      },
      {
        q: 'Is the first consultation non-binding?',
        a: 'Yes, the initial consultation is non-binding and helps us understand your goals.',
      },
      {
        q: 'Can you also implement recommendations after an audit?',
        a: 'Yes, we can also implement the recommendations right after the audit.',
      },
    ],
  },
}[locale];
---

<BaseLayout title={`${t.title} — digitance.`} description={t.sub} showCta={false}>
  <article>
    <PageHero heroLabel={t.heroLabel} heroTitle={t.title} heroSubLeft={t.heroSubLeft} />
    <section class="contact-content border-t border-brand-cloud bg-brand-white px-4 py-16 md:px-6 md:py-24">
      <div class="mx-auto max-w-5xl">
        <Reveal>
          <p class="mx-auto mb-8 max-w-3xl text-center text-brand-gray">{t.sub}</p>
          <div class="mb-8 text-center">
            <a
              href="mailto:info@digitance.cz"
              class="inline-flex items-center gap-2 rounded-2xl bg-[#353A61] px-7 py-3 font-medium text-white transition-colors hover:bg-[#2d3153] hover:text-white"
            >
              {t.cta}
            </a>
          </div>
          <div class="contact-partners mb-8">
            <a
              href="https://www.google.com/partners/agency?id=3654930267"
              target="_blank"
              rel="noopener noreferrer"
              class="partner-badge"
              aria-label="Google Partner"
            >
              <img
                src="https://www.gstatic.com/partners/badge/images/2026/PartnerBadgeClickable.svg"
                alt="Google Partner"
                width="252"
                height="84"
                class="h-[84px] w-auto"
              />
            </a>
            <a
              href="https://partneri.shoptet.sk/profesionali/digitance/"
              target="_blank"
              rel="noopener noreferrer"
              class="partner-badge"
              aria-label="Shoptet Partner"
            >
              <img
                src="https://partneri.shoptet.sk/wp-content/uploads/2023/04/shoptet-partner-bronze.png"
                alt="Shoptet Partner"
                width="90"
                height="40"
                class="h-10 w-auto"
              />
            </a>
          </div>
          <div class="grid gap-6 md:grid-cols-2">
            <article class="contact-card rounded-2xl border border-brand-cloud bg-white p-6 shadow-sm">
              <h2 class="text-xl font-semibold text-brand-ink">{t.czRegion}</h2>
              <ul class="mt-4 space-y-2 text-brand-gray">
                <li class="contact-item">
                  <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92V20a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 11.2 19.8 19.5 19.5 0 0 1 4.2 12.8 19.79 19.79 0 0 1 2 4.18 2 2 0 0 1 4 2h3.09a2 2 0 0 1 2 1.72c.12.86.32 1.7.59 2.5a2 2 0 0 1-.45 2.11L8 9.91a16 16 0 0 0 6.09 6.09l1.58-1.23a2 2 0 0 1 2.11-.45c.8.27 1.64.47 2.5.59A2 2 0 0 1 22 16.92Z"/></svg>
                  <a href={`tel:${t.czPhone.replace(/\s+/g, '')}`} class="hover:text-brand-ink">{t.czPhone}</a>
                </li>
                <li class="contact-item">
                  <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v.4l-10 6.25L2 6.4V6a2 2 0 0 1 2-2Z"/><path d="M2 8.7V18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8.7l-9.47 5.92a1 1 0 0 1-1.06 0L2 8.7Z"/></svg>
                  <a href={`mailto:${t.czEmail}`} class="hover:text-brand-ink">{t.czEmail}</a>
                </li>
                <li class="contact-item">
                  <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                  <span>{t.czPlace}</span>
                </li>
              </ul>
            </article>
            <article class="contact-card rounded-2xl border border-brand-cloud bg-white p-6 shadow-sm">
              <h2 class="text-xl font-semibold text-brand-ink">{t.skRegion}</h2>
              <ul class="mt-4 space-y-2 text-brand-gray">
                <li class="contact-item">
                  <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92V20a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 11.2 19.8 19.5 19.5 0 0 1 4.2 12.8 19.79 19.79 0 0 1 2 4.18 2 2 0 0 1 4 2h3.09a2 2 0 0 1 2 1.72c.12.86.32 1.7.59 2.5a2 2 0 0 1-.45 2.11L8 9.91a16 16 0 0 0 6.09 6.09l1.58-1.23a2 2 0 0 1 2.11-.45c.8.27 1.64.47 2.5.59A2 2 0 0 1 22 16.92Z"/></svg>
                  <a href={`tel:${t.skPhone.replace(/\s+/g, '')}`} class="hover:text-brand-ink">{t.skPhone}</a>
                </li>
                <li class="contact-item">
                  <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v.4l-10 6.25L2 6.4V6a2 2 0 0 1 2-2Z"/><path d="M2 8.7V18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8.7l-9.47 5.92a1 1 0 0 1-1.06 0L2 8.7Z"/></svg>
                  <a href={`mailto:${t.skEmail}`} class="hover:text-brand-ink">{t.skEmail}</a>
                </li>
                <li class="contact-item">
                  <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                  <span>{t.skPlace}</span>
                </li>
              </ul>
            </article>
          </div>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            <article class="billing-card rounded-2xl border border-brand-cloud p-6 md:p-8">
              <div class="billing-heading">
                <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M8 15h3"/><path d="M14 15h2"/></svg>
                <h2 class="text-xl font-semibold text-brand-ink">Billing details</h2>
              </div>
              <div class="mt-4 space-y-1 text-brand-gray">
                <p class="font-medium text-brand-ink">Digitance CZ s. r. o.</p>
                <p>Company ID: 248 92 581</p>
                <p>Data box ID: e6xac7t</p>
                <p>Not a VAT payer</p>
                <p>Uralska 689/7,</p>
                <p>160 00 Prague 6</p>
              </div>
            </article>
            <article class="bank-card rounded-2xl border border-brand-cloud p-6 md:p-8">
              <div class="billing-heading">
                <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 15h3"/><path d="M13 15h4"/><path d="M3 10h18"/></svg>
                <h2 class="text-xl font-semibold text-brand-ink">Banking details</h2>
              </div>
              <div class="mt-4 space-y-1 text-brand-gray">
                <p>Bank account: 3622203017</p>
                <p>Air Bank: 3030</p>
                <p>IBAN: CZ96 3030 0000 0000 3622 2030 17</p>
                <p>Swift: AIRACZPP</p>
              </div>
            </article>
          </div>
          <section class="faq-card mt-8 rounded-2xl border border-brand-cloud p-6 md:p-8">
            <h2 class="text-xl font-semibold text-brand-ink">{t.faqTitle}</h2>
            <div class="mt-4 space-y-3">
              {t.faqItems.map((item) => (
                <details class="faq-item rounded-xl border border-brand-cloud/80 bg-white p-4">
                  <summary class="faq-summary cursor-pointer list-none font-medium text-brand-ink">
                    <span>{item.q}</span>
                    <span class="faq-plus" aria-hidden="true">+</span>
                  </summary>
                  <p class="mt-3 text-brand-gray">{item.a}</p>
                </details>
              ))}
            </div>
          </section>
        </Reveal>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .contact-content {
    background: #ffffff;
  }
  .contact-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .contact-card:hover {
    transform: translateY(-2px);
    border-color: rgba(53, 58, 97, 0.25);
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .contact-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .billing-card {
    background:
      radial-gradient(circle at top right, rgba(243, 173, 25, 0.1), transparent 45%),
      linear-gradient(180deg, rgba(53, 58, 97, 0.03), rgba(53, 58, 97, 0));
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
  }
  .bank-card {
    background:
      radial-gradient(circle at top left, rgba(53, 58, 97, 0.08), transparent 45%),
      linear-gradient(180deg, rgba(243, 173, 25, 0.08), rgba(243, 173, 25, 0));
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
  }
  .billing-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .faq-card {
    background:
      radial-gradient(circle at bottom left, rgba(53, 58, 97, 0.06), transparent 45%),
      #ffffff;
  }
  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq-plus {
    color: #353a61;
    font-size: 1.2rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  .faq-item[open] .faq-plus {
    transform: rotate(45deg);
  }
  .contact-partners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .partner-badge img {
    transition: opacity 0.2s ease;
  }
  .partner-badge:hover img {
    opacity: 0.9;
  }
</style>
