---

<BaseLayout title="digitance. — Brands & Digital Experiences" description={t.sub}>
  <article>
    <HeroSection
      t={{
        welcome: t.welcome,
        headline: t.headline,
        headlineLine1: t.headlineLine1,
        headlineLine2: t.headlineLine2,
        headlineLine3: t.headlineLine3,
        sub: t.sub,
        cta: t.cta,
        clients: t.clients,
        solutions: t.solutions,
      }}
      locale={locale}
      contactUrl={contactUrl}
      servicesUrl={getRelativeLocaleUrl(locale, getPathForLocale(locale, 'services'))}
    />

    <AboutSection
      aboutTag={t.aboutTag}
      aboutTitleLine1={t.aboutTitleLine1}
      aboutTitleLine2={t.aboutTitleLine2}
      aboutText={t.aboutText}
      aboutStatText={t.aboutStatText}
      serviceTags={t.aboutServiceTags}
      locale={locale}
    />

    <HowWeWorkSection
      howTag={t.howTag}
      howTitleLine1={t.howTitleLine1}
      howTitleLine2={t.howTitleLine2}
      howText={t.howText}
      steps={t.howSteps}
    />

    <ServicesSection
      servicesTag={t.servicesTag}
      servicesHeading={t.servicesHeading}
      servicesIntro={t.servicesIntro}
      locale={locale}
      servicesPath={getPathForLocale(locale, 'services')}
    />

    <PortfolioSection
      portfolioTag={t.portfolioTag}
      portfolioHeading={t.portfolioHeading}
      portfolioIntro={t.portfolioIntro}
      portfolioCta={t.portfolioCta}
      locale={locale}
      portfolioUrl={getPathForLocale(locale, 'portfolio')}
    />

    <ReferencesSection
      referencesTag={t.referencesTag}
      referencesHeading={t.referencesHeading}
      referencesIntro={t.referencesIntro}
      locale={locale}
    />

  </article>
</BaseLayout>
