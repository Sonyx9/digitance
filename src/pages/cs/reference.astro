---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale } from '../../lib/i18n';
import ReferencesPageContent from '../../components/ReferencesPageContent.astro';
import { referencePageContent } from '../../data/referencePage';

const locale = Astro.currentLocale as Locale;
const t = referencePageContent[locale];
---

<BaseLayout title={t.title} description={t.intro ?? t.heroSubLeft}>
  <ReferencesPageContent locale={locale} />
</BaseLayout>
