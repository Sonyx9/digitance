---
/**
 * Třetí sekce „Jak pracujeme“ podle předlohy:
 * - Jemná mřížka v pozadí (pouze čáry, bez tmavých čtverečků)
 * - Vlevo: tag (bílý, tenký šedý okraj), nadpis na 2 řádky, odstavec, doodle (kudrnatá šipka)
 * - Vpravo/dole: karty kroků s připínáčkem nahoře, lehce natočené, čárkované spojnice
 */
import Reveal from './Reveal.astro';
import Tag from './Tag.astro';

interface Step {
  number: string;
  title: string;
  description: string;
}

interface Props {
  howTag: string;
  howTitleLine1: string;
  howTitleLine2: string;
  howText: string;
  steps: Step[];
}

const { howTag, howTitleLine1, howTitleLine2, howText, steps } = Astro.props;

const cardRotations = ['-2deg', '1.5deg', '-1deg', '2deg'];
---

<section class="how-section relative overflow-hidden px-4 py-16 md:px-6 md:py-24">
  <div class="mx-auto relative z-10 max-w-7xl">
    <Reveal>
      <div class="grid gap-10 lg:grid-cols-[1fr,1.2fr] lg:gap-16 lg:items-start">
        <!-- Levý blok: tag, nadpis, text, doodle -->
        <div class="space-y-4">
          <Tag>{howTag}</Tag>
          <h2 class="font-display text-display-lg font-bold text-brand-ink max-w-xl">
            <span class="block">{howTitleLine1}</span>
            <span class="block">{howTitleLine2}</span>
          </h2>
          <div class="relative pr-12">
            <p class="max-w-xl text-brand-gray leading-relaxed">
              {howText}
            </p>
          </div>
        </div>

        <!-- Pravý blok: mřížka jen tady + karty -->
        <div class="how-cards-wrap relative min-h-[420px] md:min-h-[480px]">
          <!-- Mřížka jen pod kartami, přechod do ztracena -->
          <div class="how-grid-bg absolute inset-0" aria-hidden="true"></div>

          <!-- Čárkované spojnice se šipkami (SVG) -->
          <svg class="how-connectors absolute inset-0 h-full w-full pointer-events-none" aria-hidden="true">
            <defs>
              <marker id="how-arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
                <path d="M0 0 L8 3 L0 6 Z" fill="#a3a3a3"/>
              </marker>
            </defs>
            <path class="how-connector-line" marker-end="url(#how-arrow)" d="M 75% 12% Q 85% 35% 45% 45%" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 4" stroke-linecap="round"/>
            <path class="how-connector-line" marker-end="url(#how-arrow)" d="M 45% 55% Q 15% 65% 25% 85%" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 4" stroke-linecap="round"/>
            <path class="how-connector-line" marker-end="url(#how-arrow)" d="M 35% 88% Q 55% 90% 75% 75%" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 4" stroke-linecap="round"/>
          </svg>

          <!-- Karty -->
          <div class="how-card absolute left-[5%] top-[8%] w-[72%] max-w-[280px] rounded-2xl border border-brand-cloud/80 bg-brand-white p-6 pt-8 shadow-md md:left-[10%] md:w-[65%]" style={`transform: rotate(${cardRotations[0]});`}>
            <span class="how-hole absolute left-1/2 top-3 -translate-x-1/2" aria-hidden="true"></span>
            <span class="text-sm font-semibold text-brand-gray">{steps[0].number}</span>
            <h3 class="mt-2 text-lg font-semibold text-brand-ink">{steps[0].title}</h3>
            <p class="mt-2 text-sm text-brand-gray leading-relaxed">{steps[0].description}</p>
          </div>
          <div class="how-card absolute left-[8%] top-[52%] w-[70%] max-w-[260px] rounded-2xl border border-brand-cloud/80 bg-brand-white p-6 pt-8 shadow-md md:left-[2%] md:w-[58%]" style={`transform: rotate(${cardRotations[1]});`}>
            <span class="how-hole absolute left-1/2 top-3 -translate-x-1/2" aria-hidden="true"></span>
            <span class="text-sm font-semibold text-brand-gray">{steps[1].number}</span>
            <h3 class="mt-2 text-lg font-semibold text-brand-ink">{steps[1].title}</h3>
            <p class="mt-2 text-sm text-brand-gray leading-relaxed">{steps[1].description}</p>
          </div>
          <div class="how-card absolute right-[5%] top-[52%] w-[68%] max-w-[260px] rounded-2xl border border-brand-cloud/80 bg-brand-white p-6 pt-8 shadow-md md:right-[8%] md:w-[55%]" style={`transform: rotate(${cardRotations[2]});`}>
            <span class="how-hole absolute left-1/2 top-3 -translate-x-1/2" aria-hidden="true"></span>
            <span class="text-sm font-semibold text-brand-gray">{steps[2].number}</span>
            <h3 class="mt-2 text-lg font-semibold text-brand-ink">{steps[2].title}</h3>
            <p class="mt-2 text-sm text-brand-gray leading-relaxed">{steps[2].description}</p>
          </div>
          <div class="how-card absolute right-[2%] top-[8%] w-[64%] max-w-[240px] rounded-2xl border border-brand-cloud/80 bg-brand-white p-6 pt-8 shadow-md md:right-[0%] md:w-[48%]" style={`transform: rotate(${cardRotations[3]});`}>
            <span class="how-hole absolute left-1/2 top-3 -translate-x-1/2" aria-hidden="true"></span>
            <span class="text-sm font-semibold text-brand-gray">{steps[3].number}</span>
            <h3 class="mt-2 text-lg font-semibold text-brand-ink">{steps[3].title}</h3>
            <p class="mt-2 text-sm text-brand-gray leading-relaxed">{steps[3].description}</p>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .how-section {
    background: #E9ECF3;
  }
  /* Mřížka jen v oblasti karet, přechod do ztracena */
  .how-grid-bg {
    background-color: transparent;
    background-image:
      linear-gradient(to right, rgba(0,0,0,0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0,0,0,0.06) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 55%, black 0%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 55%, black 0%, transparent 75%);
  }
  .how-connector-line {
    color: #a3a3a3;
  }
  .how-cards-wrap {
    padding: 1rem 0;
  }
  .how-card {
    position: absolute;
  }
  /* Děrování: uvnitř karty, světlý otvor (jako vyražená díra v papíře) */
  .how-hole {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.08);
    background: radial-gradient(circle at 35% 35%, #e8e8e8, #d0d0d0);
    box-shadow:
      inset 0 1px 2px rgba(0,0,0,0.08),
      inset 0 -1px 0 rgba(255,255,255,0.6);
  }
</style>
