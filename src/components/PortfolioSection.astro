---
/**
 * Sekce Portfolio: světlé pozadí, tag + nadpis, horizontální carousel karet projektů,
 * každá karta s názvem, podtitulem, tlačítkem šipky a místem pro náhled (mockup).
 * Dole CTA „Zobrazit všechny projekty“.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import Tag from './Tag.astro';
import { portfolioProjects } from '../data/portfolio';
import type { Locale } from '../lib/i18n';

interface Props {
  portfolioTag: string;
  portfolioHeading: string;
  portfolioIntro: string;
  portfolioCta: string;
  locale: Locale;
  portfolioUrl: string;
}

const { portfolioTag, portfolioHeading, portfolioIntro, portfolioCta, locale, portfolioUrl } = Astro.props;
---

<section class="portfolio-section bg-brand-cloud/50 px-4 py-16 md:px-6 md:py-24" id="portfolio">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-6 lg:grid-cols-[1fr,1fr] lg:gap-12 lg:items-start">
      <div class="order-1">
        <Tag>{portfolioTag}</Tag>
        <h2 class="mt-4 font-display text-display-lg font-bold text-brand-ink max-w-xl">
          {portfolioHeading}
        </h2>
      </div>
      <p class="portfolio-intro text-brand-gray leading-relaxed order-2 lg:text-right lg:flex lg:items-end lg:justify-end">
        {portfolioIntro}
      </p>
    </div>

    <div class="portfolio-carousel-wrap mt-12 -mx-4 md:-mx-6">
      <div
        class="portfolio-carousel flex gap-6 overflow-x-auto overflow-y-hidden pb-4 pt-2 px-4 md:px-6 scroll-smooth snap-x snap-mandatory"
        id="portfolio-carousel"
        role="list"
      >
        {portfolioProjects.map((project, i) => {
          const title = project.title[locale];
          const subtitle = project.subtitle[locale];
          const href = portfolioUrl ? getRelativeLocaleUrl(locale, `${portfolioUrl}/${project.slug}`) : '#';
          return (
            <article class="portfolio-card flex-shrink-0 w-[85vw] max-w-[340px] snap-center md:w-[380px]" role="listitem" data-portfolio-index={i}>
              <a href={href} class="portfolio-card-link block rounded-2xl border border-brand-cloud bg-white p-5 shadow-sm transition-shadow hover:shadow-md h-full flex flex-col">
                <div class="flex items-start justify-between gap-3 mb-4">
                  <div>
                    <h3 class="text-lg font-semibold text-brand-ink">{title}</h3>
                    <p class="text-sm text-brand-gray mt-0.5">{subtitle}</p>
                  </div>
                  <span class="portfolio-card-btn flex-shrink-0 w-10 h-10 rounded-full bg-[#353A61] flex items-center justify-center text-white transition-colors hover:bg-[#2d3153]" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
                <div class="portfolio-card-preview mt-auto rounded-xl bg-brand-cloud/80 aspect-[4/3] flex items-center justify-center text-brand-gray/50 text-sm">
                  Preview
                </div>
              </a>
            </article>
          );
        })}
      </div>

      <div class="portfolio-dots flex justify-center gap-2 mt-6" role="tablist" aria-label="Projekty">
        {portfolioProjects.map((_, i) => (
          <button
            type="button"
            class="portfolio-dot w-2.5 h-2.5 rounded-full border-0 bg-brand-gray/30 transition-colors hover:bg-brand-gray/50 focus:outline-none focus:ring-2 focus:ring-brand-ink/30"
            aria-label={`Projekt ${i + 1}`}
            aria-selected={i === 0}
            data-portfolio-dot={i}
          ></button>
        ))}
      </div>
    </div>

    <div class="mt-10 flex justify-center">
      <a
        href={portfolioUrl ? getRelativeLocaleUrl(locale, portfolioUrl) : '#'}
        class="portfolio-cta inline-flex items-center gap-2 rounded-xl bg-[#353A61] px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-[#2d3153]"
      >
        {portfolioCta}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  (function () {
    const carousel = document.getElementById('portfolio-carousel');
    const dots = document.querySelectorAll('[data-portfolio-dot]');
    if (!carousel || !dots.length) return;

    const cards = carousel.querySelectorAll('[data-portfolio-index]');
    const gap = 24;

    const updateDots = (index: number) => {
      dots.forEach((dot, i) => {
        (dot as HTMLElement).setAttribute('aria-selected', String(i === index));
        dot.classList.toggle('bg-brand-ink', i === index);
        dot.classList.toggle('bg-brand-gray/30', i !== index);
      });
    };

    const scrollToIndex = (index: number) => {
      const card = cards[index] as HTMLElement;
      if (card) {
        const cardWidth = card.offsetWidth;
        carousel.scrollTo({ left: index * (cardWidth + gap), behavior: 'smooth' });
        updateDots(index);
      }
    };

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => scrollToIndex(i));
    });

    let ticking = false;
    carousel.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const scrollLeft = carousel.scrollLeft;
        const cardWidth = (cards[0] as HTMLElement).offsetWidth;
        const index = Math.round(scrollLeft / (cardWidth + gap));
        updateDots(Math.min(Math.max(0, index), dots.length - 1));
        ticking = false;
      });
    });

    updateDots(0);
  })();
</script>

<style>
  .portfolio-section {
    background-color: #E9ECF3;
  }
  .portfolio-carousel {
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .portfolio-carousel::-webkit-scrollbar {
    display: none;
  }
  .portfolio-dot.bg-brand-ink {
    background-color: #353A61 !important;
  }
  .portfolio-card-btn {
    flex-shrink: 0;
  }
</style>
