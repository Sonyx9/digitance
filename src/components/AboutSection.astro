---
/**
 * Sekce O nás podle předlohy:
 * - Tag "About us" s tenkým černým okrajem (oval)
 * - Nadpis na 2 řádky + doodle šipka a sunburst
 * - Odstavec, černý blok s vlnkovým vzorem, 40% + tagy (bílé ovály, mírně natočené)
 * - Vpravo 2 obrázky (placeholder)
 */
import Reveal from './Reveal.astro';
import Tag from './Tag.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getPathForLocale, type Locale } from '../lib/i18n';

interface Props {
  aboutTag: string;
  aboutTitleLine1: string;
  aboutTitleLine2: string;
  aboutText: string;
  aboutStatText: string;
  serviceTags: string[];
  locale: Locale;
}

const { aboutTag, aboutTitleLine1, aboutTitleLine2, aboutText, aboutStatText, serviceTags, locale } = Astro.props;

const tagClasses = serviceTags.map(() => 'about-service-tag flex items-center justify-center gap-2 border border-white/20 px-4 py-3 text-sm font-medium text-white/95 backdrop-blur-sm');
const serviceTagLinks = [
  getRelativeLocaleUrl(locale, `${getPathForLocale(locale, 'services')}/ppc-kampane`),
  getRelativeLocaleUrl(locale, `${getPathForLocale(locale, 'services')}/seo-sluzby`),
  getRelativeLocaleUrl(locale, `${getPathForLocale(locale, 'services')}/tvorba-e-shopov`),
  getRelativeLocaleUrl(locale, `${getPathForLocale(locale, 'services')}/tvorba-webov`),
  getRelativeLocaleUrl(locale, `${getPathForLocale(locale, 'services')}/newslettery`),
  getRelativeLocaleUrl(locale, `${getPathForLocale(locale, 'services')}/audit-kampane`),
];
---

<section class="about-section relative bg-brand-white px-4 py-16 md:px-6 md:py-24">
  <div class="about-section-grid" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-7xl">
    <Reveal>
      <!-- Tmavý blok se službami (pod loga) -->
      <div class="about-stat-card relative overflow-hidden rounded-2xl px-6 py-10 text-brand-white md:px-12 md:py-12">
        <div class="about-stat-glow" aria-hidden="true"></div>
        <div class="about-stat-waves absolute inset-0" aria-hidden="true">
          <svg class="h-full w-full" viewBox="0 0 500 220" preserveAspectRatio="xMinYMid slice" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 100 Q80 60 160 100 T 320 100 T 500 100" fill="none" stroke="white" stroke-width="1" opacity="0.7" />
            <path d="M0 120 Q70 90 140 120 T 280 120 T 500 120" fill="none" stroke="white" stroke-width="0.8" opacity="0.6" />
            <path d="M0 80 Q90 50 180 80 T 360 80 T 500 80" fill="none" stroke="white" stroke-width="0.8" opacity="0.6" />
            <path d="M0 140 Q60 110 120 140 T 240 140 T 500 140" fill="none" stroke="white" stroke-width="0.6" opacity="0.5" />
            <path d="M0 60 Q100 30 200 60 T 400 60 T 500 60" fill="none" stroke="white" stroke-width="0.6" opacity="0.5" />
            <path d="M0 160 Q50 135 100 160 T 200 160 T 500 160" fill="none" stroke="white" stroke-width="0.5" opacity="0.4" />
          </svg>
        </div>
        <div class="relative z-10 w-full">
          <p class="about-stat-text text-sm md:text-base leading-relaxed max-w-2xl mx-auto text-center">
            {aboutStatText}
          </p>
          <div class="about-service-tags mt-8 w-full">
            {serviceTags.map((label, i) => (
              <a href={serviceTagLinks[i] ?? getRelativeLocaleUrl(locale, getPathForLocale(locale, 'services'))} class={tagClasses[i]}>
                <span class="about-tag-dot h-1.5 w-1.5 shrink-0 rounded-full bg-[#F3AD19]" aria-hidden="true"></span>
                <span>{label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Proč Digitance (pod tmavým blokem) -->
      <div class="grid gap-8 lg:grid-cols-3 lg:gap-12 mt-12 md:mt-16">
        <div class="lg:col-span-2 space-y-6">
          <Tag>{aboutTag}</Tag>
          <div class="about-heading-wrap relative">
            <h2 class="font-display text-display-lg font-bold text-brand-ink">
              <span class="block">{aboutTitleLine2}</span>
            </h2>
          </div>
          <p class="max-w-xl text-brand-gray leading-relaxed">
            {aboutText}
          </p>
        </div>
        <div class="flex flex-col gap-6">
          <div class="aspect-[4/3] rounded-2xl bg-brand-cloud overflow-hidden">
            <img
              src="/images/team-digitance-home.png"
              alt="Tím Digitance"
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .about-section {
    background: #ffffff;
  }
  .about-section-grid {
    position: absolute;
    inset: 1px 0 0 0;
    z-index: 0;
    background-image:
      linear-gradient(to right, rgba(0, 0, 0, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.06) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    /* Bez přechodového maskování mezi sekcemi */
    mask-image: none;
    -webkit-mask-image: none;
  }
  .about-section-grid::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top, #ffffff 0, rgba(255, 255, 255, 0) 72px),
      linear-gradient(to right, #ffffff 0, rgba(255, 255, 255, 0) 56px, rgba(255, 255, 255, 0) calc(100% - 56px), #ffffff 100%);
  }
  .about-heading-wrap {
    padding-right: 3rem;
  }
  .about-stat-card {
    background:
      radial-gradient(circle at 14% 18%, rgba(243, 173, 25, 0.2), transparent 34%),
      radial-gradient(circle at 82% 92%, rgba(91, 101, 158, 0.28), transparent 40%),
      linear-gradient(145deg, #2c3152 0%, #353A61 42%, #232843 100%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      0 18px 42px rgba(17, 24, 39, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }
  .about-stat-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.14) 0%, transparent 36%),
      radial-gradient(circle at 88% 14%, rgba(243, 173, 25, 0.14), transparent 34%);
  }
  .about-stat-text {
    color: rgba(248, 250, 252, 0.96);
    text-shadow: 0 1px 10px rgba(15, 23, 42, 0.25);
  }
  .about-stat-waves {
    opacity: 0.34;
  }
  .about-stat-waves svg {
    width: 120%;
    height: 100%;
  }
  .about-service-tags {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 52rem;
    margin-left: auto;
    margin-right: auto;
  }
  @media (min-width: 640px) {
    .about-service-tags {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 960px) {
    .about-service-tags {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .about-service-tag {
    width: 100%;
    min-height: 3rem;
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.07);
    text-align: center;
  }
  /* Tvary rámečků */
  .about-tag-dot {
    box-shadow: 0 0 8px #F3AD19;
  }
</style>
