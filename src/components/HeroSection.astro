---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Reveal from './Reveal.astro';
import Tag from './Tag.astro';
import HeroGridBg from './HeroGridBg.astro';
import HeroCta from './HeroCta.astro';
import { portfolioItems } from '../data/portfolioPage';
import type { Locale } from '../lib/i18n';

interface Props {
  t: {
    welcome: string;
    headline: string;
    /** Tři řádky nadpisu (pokud jsou, hvězdička je vedle druhého řádku) */
    headlineLine1?: string;
    headlineLine2?: string;
    headlineLine3?: string;
    sub: string;
    cta: string;
    clients: string;
    solutions: string;
  };
  locale: Locale;
  contactUrl: string;
  servicesUrl: string;
}

const { t, locale, contactUrl, servicesUrl } = Astro.props;
const useLines = t.headlineLine1 != null && t.headlineLine2 != null && t.headlineLine3 != null;
const heroBrandLogos = portfolioItems
  .filter((item) => Boolean(item.logo))
  .map((item) => {
    const lowerTitle = item.title.toLowerCase();
    const needsInvertBlack = lowerTitle.includes('primadora') || lowerTitle.includes('pantheraleo');
    return {
      title: item.title,
      logo: item.logo!,
      needsInvertBlack,
    };
  });
---

<section class="hero-section relative overflow-hidden px-4 pb-8 pt-8 md:px-6 md:pb-12 md:pt-16">
  <HeroGridBg />
  <div class="relative mx-auto max-w-7xl">
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-6 lg:items-center">
      <div>
        <Reveal class="block">
          <Tag class="mb-6">{t.welcome}</Tag>
          <h1 class="hero-headline font-display text-display-xl font-bold text-[#1a1a2e]">
            {useLines ? (
              <>
                <span class="block">{t.headlineLine1}</span>
                <span class="hero-headline-line-with-star inline-flex flex-wrap items-center gap-x-2">
                  {t.headlineLine2}
                </span>
                <span class="block">{t.headlineLine3}</span>
              </>
            ) : (
              <span class="inline-flex flex-wrap items-baseline gap-x-2">
                {t.headline}
              </span>
            )}
          </h1>
          <p class="mt-6 max-w-xl text-brand-gray">
            {t.sub}
          </p>
          <HeroCta href={contactUrl} label={t.cta} />
        </Reveal>
      </div>
      <Reveal class="relative flex items-end justify-end">
        <div class="w-full max-w-[520px] ml-auto">
          <img
            src="/hero-pozadi-digitance.png"
            alt="Pozadí Digitance"
            class="h-auto w-full"
            loading="eager"
            decoding="async"
          />
        </div>
      </Reveal>
    </div>

    <!-- Referenční loga od začátku do konce (celá šířka sekce) -->
    <div class="brands-carousel-wrap mt-8 md:mt-12 -mx-4 md:-mx-6 px-4 md:px-6">
      <div class="brands-carousel" aria-label="Loga projektů">
        <div class="brands-carousel-track">
          {heroBrandLogos.map((item) => (
            <span class="brands-carousel-item">
              <img
                src={item.logo}
                alt={`Logo ${item.title}`}
                class:list={['brands-carousel-logo', item.needsInvertBlack && 'brands-carousel-logo--invert-black']}
                loading="lazy"
                decoding="async"
              />
            </span>
          ))}
        </div>
        <div class="brands-carousel-track" aria-hidden="true">
          {heroBrandLogos.map((item) => (
            <span class="brands-carousel-item">
              <img
                src={item.logo}
                alt=""
                class:list={['brands-carousel-logo', item.needsInvertBlack && 'brands-carousel-logo--invert-black']}
                loading="lazy"
                decoding="async"
              />
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background: transparent;
  }
  .hero-headline {
    text-wrap: balance;
  }
  .hero-headline-line-with-star {
    display: inline-flex;
    align-items: center;
  }
  .brands-carousel-wrap {
    position: relative;
    overflow: hidden;
  }
  .brands-carousel {
    display: flex;
    width: max-content;
    animation: brands-scroll 35s linear infinite;
  }
  .brands-carousel-track {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-shrink: 0;
    padding: 0.5rem 0;
  }
  .brands-carousel-item {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 9rem;
    height: 2.4rem;
  }
  .brands-carousel-logo {
    max-width: 8.2rem;
    max-height: 1.8rem;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1) contrast(1.05) opacity(0.88);
    transition: filter 0.25s ease, opacity 0.25s ease;
  }
  .brands-carousel-logo--invert-black {
    filter: grayscale(1) brightness(0) opacity(0.84);
  }
  .brands-carousel-item:hover .brands-carousel-logo {
    filter: grayscale(1) contrast(1.08) opacity(1);
  }
  .brands-carousel-item:hover .brands-carousel-logo--invert-black {
    filter: grayscale(1) brightness(0) opacity(0.95);
  }
  @keyframes brands-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .brands-carousel {
      animation: none;
    }
  }
</style>
