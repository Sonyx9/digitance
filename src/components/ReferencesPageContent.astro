---
/**
 * Stránka Reference: stejný hero jako O nás (PageHero), pod ním textové reference od klientů.
 * U každé karty: logo (Clearbit podle domény nebo iniciály), jméno, web, citace.
 */
import PageHero from './PageHero.astro';
import { referencePageContent } from '../data/referencePage';
import { clientReferences } from '../data/references';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = referencePageContent[locale];

/** Iniciály z jména (např. "Mirka P." → "MP", "Petr" → "P") */
function getInitials(name: string): string {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  return (parts[0]?.[0] ?? '?').toUpperCase();
}
---

<article class="references-page">
  <PageHero
    heroLabel={t.heroLabel}
    heroTitle={t.heroTitle}
    heroSubLeft={t.heroSubLeft}
  />

  <section class="references-content">
    <div class="references-content-inner">
      {t.intro && <p class="references-intro">{t.intro}</p>}
      <div class="references-grid" role="list">
        {clientReferences.map((ref) => {
          const logoUrl = ref.logo ?? `https://logo.clearbit.com/${ref.website}`;
          const websiteHref = ref.website.startsWith('http') ? ref.website : `https://${ref.website}`;
          const initials = getInitials(ref.name);
          const quoteText = locale === 'en' && ref.quoteEn ? ref.quoteEn : ref.quote;
          return (
            <article class="references-card" role="listitem">
              <div class="references-card-header">
                <div class="references-card-logo-wrap">
                  <img
                    src={logoUrl}
                    alt=""
                    class="references-card-logo"
                    width="80"
                    height="80"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="references-card-logo-fallback" aria-hidden="true">{initials}</span>
                </div>
                <span class="references-card-quote-mark" aria-hidden="true">„</span>
              </div>
              <h3 class="references-card-name">{ref.name}</h3>
              <a
                href={websiteHref}
                target="_blank"
                rel="noopener noreferrer"
                class="references-card-website"
              >
                {ref.website}
              </a>
              <p class="references-card-quote">{quoteText}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</article>

<style>
  .references-page {
    background: #ffffff;
  }
  .references-content {
    padding: 2rem 1.5rem 4rem;
    border-top: 1px solid rgba(26, 26, 46, 0.2);
  }
  @media (min-width: 768px) {
    .references-content {
      padding: 2.5rem 2rem 5rem;
    }
  }
  .references-content-inner {
    max-width: 72rem;
    margin: 0 auto;
  }
  .references-intro {
    font-size: 1rem;
    color: var(--color-brand-gray, #6b7280);
    margin: 0 0 1.5rem;
    line-height: 1.6;
  }
  .references-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .references-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .references-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
  .references-card {
    border: 1px solid rgba(233, 236, 243, 0.9);
    border-radius: 1rem;
    padding: 1.25rem;
    background: #fff;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
    transition: box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .references-card:hover {
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.1);
  }
  .references-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .references-card-logo-wrap {
    position: relative;
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(145deg, #f1f5f9 0%, #e2e8f0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .references-card-logo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6px;
  }
  .references-card-logo-fallback {
    position: absolute;
    font-size: 1.5rem;
    font-weight: 700;
    color: #353A61;
    background: rgba(243, 173, 25, 0.25);
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .references-card-logo-fallback {
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .references-card-logo[data-failed] {
    opacity: 0;
  }
  .references-card-logo[data-failed] + .references-card-logo-fallback {
    opacity: 1;
  }
  .references-card-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-brand-ink, #1a1a2e);
    margin: 0 0 0.2rem;
  }
  .references-card-website {
    font-size: 0.875rem;
    color: #F3AD19;
    text-decoration: none;
    margin-bottom: 0.75rem;
    word-break: break-all;
  }
  .references-card-website:hover {
    text-decoration: underline;
  }
  .references-card-quote {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-brand-gray, #4b5563);
    margin: 0;
    flex: 1;
  }
  .references-card-quote-mark {
    font-size: 4rem;
    line-height: 1;
    color: rgba(243, 173, 25, 0.5);
    font-family: Georgia, serif;
    flex-shrink: 0;
  }
</style>

<script>
  // Fallback: když Clearbit logo selže (404), zobrazíme iniciály
  document.querySelectorAll('.references-card-logo').forEach((img: HTMLImageElement) => {
    img.addEventListener('error', () => img.setAttribute('data-failed', ''));
  });
</script>
