---
/**
 * Sdílený hero blok pro stránky (O nás, Reference): mřížka, label, velký nadpis + žlutá tečka, podtitul.
 */
import Reveal from './Reveal.astro';

interface Props {
  heroLabel: string;
  heroTitle: string;
  heroSubLeft: string;
}

const { heroLabel, heroTitle, heroSubLeft } = Astro.props;
---

<header class="page-hero">
  <div class="page-hero-grid" aria-hidden="true"></div>
  <div class="page-hero-inner">
    <Reveal>
      <p class="page-hero-label">{heroLabel}</p>
      <div class="page-hero-title-row">
        <h1 class="page-hero-title">{heroTitle}</h1>
        <span class="page-hero-dot" aria-hidden="true"></span>
      </div>
      <div class="page-hero-sub">
        <span class="page-hero-sub-left">{heroSubLeft}</span>
      </div>
    </Reveal>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 28rem;
    padding: 4rem 1.5rem;
  }
  @media (min-width: 768px) {
    .page-hero {
      min-height: 32rem;
      padding: 6rem 2rem;
    }
  }
  .page-hero-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: #ffffff;
    background-image:
      linear-gradient(to right, rgba(0, 0, 0, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.06) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 100% 90% at 50% 50%, black 25%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse 100% 90% at 50% 50%, black 25%, transparent 72%);
  }
  .page-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    text-align: left;
    align-self: stretch;
  }
  .page-hero-label {
    font-size: 0.8rem;
    color: var(--color-brand-gray, #6b7280);
    margin: 0 0 0.25rem;
  }
  .page-hero-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.25rem;
  }
  .page-hero-title {
    font-size: clamp(2.5rem, 10vw, 4.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-brand-ink, #1a1a2e);
    margin: 0;
  }
  .page-hero-dot {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: #F3AD19;
    vertical-align: 0.25em;
    margin-left: 0.2rem;
  }
  .page-hero-sub {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.6rem;
    font-size: 0.8rem;
    color: var(--color-brand-gray, #6b7280);
  }
</style>
