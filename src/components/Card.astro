---
interface Props {
  title: string;
  description?: string;
  class?: string;
  dark?: boolean;
}
const { title, description = '', class: className = '', dark = false } = Astro.props;
---

<article
  class:list={[
    'rounded-2xl p-6 transition-transform duration-200 animate-gpu',
    dark ? 'bg-brand-stone text-brand-white' : 'bg-brand-cloud text-brand-ink',
    className,
  ]}
>
  <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-black/10">
    <slot name="icon" />
  </div>
  <h3 class="text-lg font-semibold">{title}</h3>
  {description && <p class="mt-2 text-sm opacity-90">{description}</p>}
  <slot />
</article>
