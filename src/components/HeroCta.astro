---
/**
 * CTA: tlačítko s textem a šipkou vpravo nahoru (ke kontaktu).
 */
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<div class="cta-block">
  <a href={href} class="cta-button group inline-flex items-center gap-3 rounded-2xl px-6 py-3 font-medium text-white transition-colors hover:opacity-95" style="background-color: #353A61">
    <span>{label}</span>
    <span class="cta-button-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="10" cy="10" r="9" fill="#F3AD19"/>
        <path d="M7 13 L13 7 M13 7 L13 11 M13 7 L9 7" stroke="#353A61" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </a>
</div>

<style>
  .cta-block {
    position: relative;
    display: inline-block;
    margin-top: 1.5rem;
  }
  .cta-button {
    position: relative;
    z-index: 1;
  }
  .cta-button-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cta-button-icon svg {
    display: block;
  }
  .cta-button-icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
