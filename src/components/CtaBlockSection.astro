---
/**
 * CTA blok pod Reference: tmavé zaoblené pozadí, nadpis, popis a tlačítko „Napište nám“.
 */
interface Props {
  ctaBlockHeading: string;
  ctaBlockSub: string;
  ctaBlockButton: string;
}
const { ctaBlockHeading, ctaBlockSub, ctaBlockButton } = Astro.props;
---

<section class="cta-block-section px-4 py-16 md:px-6 md:py-20" aria-label="Call to action">
  <div class="mx-auto max-w-5xl">
    <div class="cta-block-inner rounded-3xl px-6 py-12 md:px-12 md:py-16 text-center relative overflow-hidden">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-white">
        {ctaBlockHeading}
      </h2>
      <p class="mt-4 text-brand-cloud/80 text-base md:text-lg max-w-xl mx-auto leading-relaxed">
        {ctaBlockSub}
      </p>
      <div class="flex justify-center mt-8">
        <a
          href="mailto:info@digitance.cz"
          class="cta-block-btn inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[#e09e14] hover:text-white"
        >
          {ctaBlockButton}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-block-section {
    background: #ffffff;
  }
  .cta-block-inner {
    background:
      radial-gradient(circle at 16% 18%, rgba(243, 173, 25, 0.14), transparent 32%),
      linear-gradient(145deg, #2f3458 0%, #353A61 50%, #272c4a 100%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 10px 32px rgba(17, 24, 39, 0.26);
  }
  .cta-block-btn {
    background: #F3AD19;
  }
</style>
